# Copy to .env (git-ignored) and replace every CHANGE_ME. Never commit real values.
# Nested settings use "__": APP_DATABASE__URL -> AppConfig.database.url

APP_ENV=dev

APP_DATABASE__URL=postgresql+psycopg://analyzer:CHANGE_ME@127.0.0.1:5432/analyzer
APP_DATABASE__POOL_SIZE=5
APP_DATABASE__STATEMENT_TIMEOUT_MS=30000

APP_STORAGE__DATASTORE_PATH=./datastore
APP_STORAGE__MAX_UPLOAD_BYTES=209715200

# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECURITY__SESSION_SECRET=CHANGE_ME
# true behind HTTPS (cookie `__Host-session`, HSTS). Set false only for plain-http local dev.
APP_SECURITY__COOKIE_SECURE=true
# Session lifetime: absolute and idle timeout, in seconds
APP_SECURITY__SESSION_TTL_S=43200
APP_SECURITY__SESSION_IDLE_S=1800
# Argon2id cost (OWASP minimum m=19456 KiB, t=2, p=1; lower values are rejected)
APP_SECURITY__ARGON2_MEMORY_KIB=19456
APP_SECURITY__ARGON2_TIME_COST=2
APP_SECURITY__ARGON2_PARALLELISM=1
# Login throttling (per process): failures per email / per client IP within the window (s)
APP_SECURITY__LOGIN_MAX_FAILURES_PER_EMAIL=5
APP_SECURITY__LOGIN_MAX_FAILURES_PER_IP=20
APP_SECURITY__LOGIN_FAILURE_WINDOW_S=900
# Max non-upload request body (uploads use APP_STORAGE__MAX_UPLOAD_BYTES)
APP_SECURITY__MAX_BODY_BYTES=1048576
# AES-256-GCM key for connector credentials (base64url, 32 bytes), e.g.
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# APP_SECURITY__CREDENTIAL_KEY=CHANGE_ME
# HMAC key for the audit hash chain (>= 32 chars). Required when APP_ENV is staging/prod; in
# dev/test it defaults to a key derived from SESSION_SECRET (key id "derived").
# Rotate: set a new key + id and move the old key into APP_SECURITY__AUDIT_RETIRED_KEYS as
# JSON, e.g. {"k1":"<old key>"}, so rows written under it still verify.
# Required by the prod compose profile (scripts/dev prod-up), e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SECURITY__AUDIT_KEY=CHANGE_ME
# APP_SECURITY__AUDIT_KEY_ID=k1
# First admin: `python -m app.security.bootstrap --email ... --workspace ...` reads the password
# from APP_BOOTSTRAP_PASSWORD (set only for that command) or prompts for it; never pass it as argv.

# Local/self-hosted LLM only (CLAUDE.md section 20). Host must be in allowed_hosts.
APP_LLM__ENDPOINT=http://127.0.0.1:11434
APP_LLM__ALLOWED_HOSTS=["127.0.0.1","localhost"]
APP_LLM__TIMEOUT_S=60

APP_OBSERVABILITY__LOG_LEVEL=INFO
# Tracing (ADR-0015): none (no-op) | console | otlp. otlp needs APP_OBSERVABILITY__OTLP_ENDPOINT
# (a local collector only) and the opentelemetry-exporter-otlp-proto-http package.
APP_OBSERVABILITY__TRACING_EXPORTER=none
# APP_OBSERVABILITY__OTLP_ENDPOINT=http://jaeger:4318/v1/traces
# /metrics on the api (outside /api, never proxied); worker metrics listener is off by default
APP_OBSERVABILITY__METRICS_ENABLED=true
# APP_OBSERVABILITY__WORKER_METRICS_PORT=9100

# Resource limits (design section 65; docs/MLOPS.md section 2)
APP_SQL__TIMEOUT_S=10
APP_SQL__MAX_ROWS=10000
APP_SQL__MEMORY_LIMIT_MB=2048
APP_SQL__THREADS=2
# Worker slots per job type (JSON), lease timing
APP_WORKER__CONCURRENCY={}
APP_WORKER__HEARTBEAT_S=10
APP_WORKER__STALE_AFTER_S=60

# External PostgreSQL snapshot import (TASK-DATA-013). Deny by default: list each source host.
# Resolved addresses are checked as well (link-local/metadata always refused; loopback only
# with ALLOW_LOOPBACK). Needs APP_SECURITY__CREDENTIAL_KEY; without it connectors answer 503.
APP_CONNECTORS__ALLOWED_HOSTS=[]
APP_CONNECTORS__ALLOWED_PORTS=[5432]
APP_CONNECTORS__ALLOW_LOOPBACK=false
APP_CONNECTORS__CONNECT_TIMEOUT_S=10
APP_CONNECTORS__STATEMENT_TIMEOUT_MS=60000
APP_CONNECTORS__MAX_ROWS=1000000

# docker compose (infra/compose) PostgreSQL bootstrap credentials
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=analyzer
# Password for the least-privilege application role `analyzer_app` (created by initdb)
APP_DB_PASSWORD=CHANGE_ME
# Host port for the API container (bound to 127.0.0.1)
API_HOST_PORT=8000
# Host port for the web (frontend/nginx) container (bound to 127.0.0.1)
WEB_HOST_PORT=8080
# Integration tests: owner/superuser URL of a disposable cluster (tests skip when unset)
# APP_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://analyzer:CHANGE_ME@127.0.0.1:5432/postgres
