{
  "$defs": {
    "AnalysisIntent": {
      "additionalProperties": false,
      "properties": {
        "compare_to": {
          "anyOf": [
            {
              "enum": [
                "previous_period",
                "same_period_last_year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare To"
        },
        "dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "filters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Filter"
          },
          "title": "Filters",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "objective": {
          "enum": [
            "overview",
            "metric_value",
            "trend",
            "compare",
            "rank",
            "explain_change",
            "forecast",
            "anomalies",
            "segments",
            "predict",
            "simulate",
            "document_lookup"
          ],
          "title": "Objective",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "system_default",
            "user_question"
          ],
          "title": "Source",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Dimension"
        }
      },
      "required": [
        "objective",
        "source"
      ],
      "title": "AnalysisIntent",
      "type": "object"
    },
    "AnalysisStep": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "default": {},
          "title": "Args",
          "type": "object"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "expected_output": {
          "title": "Expected Output",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "tool": {
          "pattern": "^[a-z]+(\\.[a-z_]+)+$",
          "title": "Tool",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "validation": {
          "default": [],
          "items": {
            "enum": [
              "schema",
              "numeric",
              "model",
              "logic"
            ],
            "type": "string"
          },
          "title": "Validation",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "tool",
        "expected_output"
      ],
      "title": "AnalysisStep",
      "type": "object"
    },
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "in",
            "between",
            "gte",
            "lte"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "format": "date",
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "dimension",
        "op",
        "value"
      ],
      "title": "Filter",
      "type": "object"
    },
    "JsonValue": {},
    "ReasonCode": {
      "description": "Why an analysis is unavailable. Shown to users via ``Unavailability`` and ``unavailable``\ndashboard widgets (typed result, not an error: TRD 35 ANALYSIS_UNAVAILABLE).",
      "enum": [
        "NO_TIME_DIMENSION",
        "IRREGULAR_TIME",
        "INSUFFICIENT_HISTORY",
        "TOO_MANY_MISSING_PERIODS",
        "NO_MEASURE",
        "NO_DIMENSION",
        "NO_CUSTOMER_IDENTIFIER",
        "NO_RETENTION_HISTORY",
        "NO_TARGET",
        "INSUFFICIENT_ENTITIES",
        "INSUFFICIENT_ROWS",
        "NO_NUMERIC_FEATURES",
        "LOW_MODEL_QUALITY",
        "SIMULATION_UNSUPPORTED",
        "ANALYSIS_FAILED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "TimeSpec": {
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "const": "gregorian",
          "default": "gregorian",
          "title": "Calendar",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "grain": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ],
          "title": "Grain",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "grain"
      ],
      "title": "TimeSpec",
      "type": "object"
    },
    "Unavailability": {
      "additionalProperties": false,
      "properties": {
        "analysis": {
          "title": "Analysis",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "would_enable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Would Enable"
        }
      },
      "required": [
        "analysis",
        "reason_code",
        "message"
      ],
      "title": "Unavailability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_version_id": {
      "pattern": "^dsv_\\w+$",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/AnalysisIntent"
    },
    "plan_id": {
      "pattern": "^pl_\\w+$",
      "title": "Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_model_version": {
      "minimum": 1,
      "title": "Semantic Model Version",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/AnalysisStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "unavailable": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Unavailability"
      },
      "title": "Unavailable",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "plan_id",
    "version",
    "dataset_version_id",
    "semantic_model_version",
    "intent",
    "steps"
  ],
  "title": "AnalysisPlan",
  "type": "object"
}
